SECRET_KEY=your-super-secret-key-change-in-production
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Reasoning AI (OpenCode Zen) - required for POST /api/v1/reasoning
OPENCODEZEN_API_KEY=oc_sk_your_key_here
OPENCODEZEN_BASE_URL=https://opencode.ai/zen/v1

# Frontend production HTTPS enforcement (see Intellirity-Frontend/.env.example)
SECURE_REDIRECT=false


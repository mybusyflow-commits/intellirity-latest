# Intellirity frontend (Next.js). Copy to Intellirity-Frontend/.env.local
# See DEPLOYMENT.md for the full production matrix.

# Clerk publishable key (pk_live_... / pk_test_...). Without it the console
# runs in open mode and the sign-in pages show a "not configured" panel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key. Without it the middleware does not protect /console, and
# a production build refuses to serve the console at all.
CLERK_SECRET_KEY=

# Optional. Where an unauthenticated visitor is sent. The defaults match the
# in-app pages; set them only if you mount the auth pages elsewhere.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Canonical site origin. Drives canonical tags, the sitemap, robots.txt,
# social cards and structured data. Vercel sets VERCEL_PROJECT_PRODUCTION_URL
# automatically -- copy it here.
NEXT_PUBLIC_SITE_URL=https://intellirity.ai

# Public origin of your deployed screening gateway, shown in the integration
# snippet. Leave blank to show a clearly-labelled placeholder.
NEXT_PUBLIC_GATEWAY_URL=

# Where the Next server proxies /backend/* to.
#   local:  http://127.0.0.1:8000/api/v1
#   docker: http://backend:8000/api/v1
BACKEND_INTERNAL_URL=http://127.0.0.1:8000/api/v1

# Label shown in the console chrome.
NEXT_PUBLIC_DEPLOY_ENV=development

# Redirect http -> https in production. Defaults to on in production.
SECURE_REDIRECT=false

# Google Analytics 4 measurement id. Analytics only loads after the visitor
# accepts it in the consent banner.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token (the msvalidate.01 meta value).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Cloudflare Turnstile site key (public). Only needed for the contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

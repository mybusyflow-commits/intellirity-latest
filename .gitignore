# See https://help.github.com/articles/ignoring-files/ for more details.

# Dependencies
node_modules/
# Only a root-level vendor bundle is generated. The frontend's src/vendor
# is source code the build imports, so it must stay committed -- without it
# a Vercel checkout cannot resolve the ThreeUI imports.
/vendor/

# Environment
.env
.env.local
.env.*.local

# Build
/build
/dist
*.pyc
__pycache__/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Database backups and dumps (never commit customer data or evidence)
backups/
*.dump
*.sql.gz

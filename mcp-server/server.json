{
  "name": "io.github.intellirity/mcp-server",
  "version": "0.1.0",
  "description": "Intellirity MCP server for AI security scans",
  "server": {
    "command": "python",
    "args": ["server.py"],
    "env": {
      "INTELLIRITY_BASE_URL": "http://localhost:8000"
    }
  },
  "tools": [
    "scan_jailbreak",
    "scan_code",
    "scan_dlp",
    "full_scan"
  ]
}

# Intellirity backend. Copy to backend/.env
# See DEPLOYMENT.md for the full production matrix.

# ---- Storage -------------------------------------------------------------
# Any Postgres. The URL is normalised to the asyncpg dialect automatically.
# Leave blank to run memory-only (state is lost on restart).
DATABASE_URL=

# ---- Identity -------------------------------------------------------------
# Clerk secret key. When set, every protected route requires a valid session
# JWT (RS256 via JWKS, or HS256 with SECRET_KEY). When unset the backend runs
# in OPEN MODE and refuses to serve in production, so a production deploy
# without this cannot start.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# The one Clerk instance whose tokens this engine trusts. Derivable from
# CLERK_PUBLISHABLE_KEY, but set it explicitly: without a pinned issuer a
# production deployment refuses to serve, because accepting the `iss` claim
# from the token itself would let any domain mint a session.
#   https://your-app.clerk.accounts.dev   (Clerk dashboard -> API keys)
CLERK_ISSUER=
# Optional: comma-separated origins a token may be minted for (Clerk `azp`).
# Set to your site origin to close cross-application token replay.
CLERK_AUTHORIZED_PARTIES=

# Machine keys for the Python/JS SDKs and the MCP server (X-API-Key).
# In production, store SHA-256 hashes of the keys, not the keys themselves:
#   python -c "import hashlib,sys;print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" MY_KEY
INTELLIRITY_API_KEY_HASHES=
# Convenience for local development only -- never use raw keys in production.
INTELLIRITY_API_KEYS=

# ---- Secrets --------------------------------------------------------------
# App secret. Used as the HS256 key for secret-key-signed session tokens and
# as the proof-of-intent signing fallback. MUST be changed in production; the
# app refuses to start in production with the default value.
SECRET_KEY=change-me-in-production

# Dedicated signing key for proof-of-intent certificates.
VPI_SIGNING_KEY=

# ---- Upstream model gateway ----------------------------------------------
# Any OpenAI-compatible gateway. Powers the reasoning endpoint and the
# reverse proxy. Models are discovered live from <base>/models.
#   Groq:  OPENCODEZEN_BASE_URL=https://api.groq.com/openai/v1
#   Zen:   OPENCODEZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODEZEN_API_KEY=
OPENCODEZEN_BASE_URL=https://api.groq.com/openai/v1
OPENCODEZEN_MODEL=

# Override the proxy's upstream (defaults to OPENCODEZEN_BASE_URL).
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=

# ---- Payments (Razorpay) --------------------------------------------------
# When KEY_ID and KEY_SECRET are set, checkout creates a live Razorpay order
# and the webhook confirms capture. When unset, checkout stays in dev mode
# (pending-payment + simulated activation). Set the webhook secret to enable
# the signed server-to-server confirmation; without it the webhook endpoint
# refuses every request (fail closed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Deployment -----------------------------------------------------------
# "production" turns on the fail-closed rules: no auth = the service refuses
# to start, insecure defaults are fatal, and Turnstile is required.
ENVIRONMENT=development

# Comma-separated allowed origins. Never "*".
ALLOWED_ORIGINS=http://localhost:3000

# Enforce plan entitlements on the module endpoints.
BILLING_ENFORCED=false

# Cloudflare Turnstile secret. Required in production: without it the public
# contact form refuses submissions rather than accepting them.
TURNSTILE_SECRET=

# ---- Contact notifications -------------------------------------------------
# The contact form always writes to the database first, so a mail outage
# never loses a lead. This block only controls whether an operator is also
# emailed about it. Configure ONE transport.

# Where notifications are sent and what the envelope sender looks like.
CONTACT_INBOX=security@intellirity.ai
EMAIL_FROM=Intellirity <noreply@intellirity.ai>

# Resend (single HTTPS call).
RESEND_API_KEY=

# SMTP (company relay, Google Workspace, Postmark SMTP, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Human-facing timezone for reports and mail. Storage is always UTC.
TIMEZONE=Asia/Kolkata

# Structured JSON logs.
LOG_JSON=false
